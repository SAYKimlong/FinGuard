# Store only on the VPS. Never commit the populated .env file.
# Create the DuckDNS subdomain/token at https://www.duckdns.org
DUCKDNS_SUBDOMAIN=finguard-yourname
DUCKDNS_TOKEN=REPLACE_WITH_DUCKDNS_TOKEN
DOMAIN=finguard-yourname.duckdns.org

# Generate separate passwords with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_python_secrets_token_urlsafe_48
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_HEX_PASSWORD

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://finguard:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/finguard
DATABASE_URL_SYNC=postgresql+psycopg://finguard:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/finguard

REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/1

OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=https://finguard-yourname.duckdns.org
