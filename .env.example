# FinGuard Environment Configuration
# Copy this file to .env and fill in values

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://finguard:finguard_secret@localhost:5432/finguard
DATABASE_URL_SYNC=postgresql://finguard:finguard_secret@localhost:5432/finguard

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ============ Auth ============
SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ LLM ============
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# ============ Storage ============
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# ============ Frontend ============
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ============ CORS ============
CORS_ORIGINS=http://localhost:3000

# ============ App ============
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
