# Copy to .env and replace every placeholder before starting the app.
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Use the same unique password in all three settings below.
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://finguard:REPLACE_WITH_A_URL_ENCODED_PASSWORD@localhost:5555/finguard
DATABASE_URL_SYNC=postgresql+psycopg://finguard:REPLACE_WITH_A_URL_ENCODED_PASSWORD@localhost:5555/finguard

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000
